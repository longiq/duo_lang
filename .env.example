GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash
PORT=3000
# Bind address. Defaults to 127.0.0.1 (behind an nginx reverse proxy).
# Set to 0.0.0.0 only if you need to reach the app directly, e.g. in a container.
HOST=127.0.0.1

# Google Cloud Text-to-Speech. Optional: without it the app falls back to
# Gemini TTS, whose free tier is only 10 requests per day per model.
# See deploy/google-cloud-tts.md, including how to cap spending.
GOOGLE_TTS_API_KEY=
# Characters per month the app will synthesise before refusing. Kept well under
# the 1M/month free tier, because Google's budget alerts only notify, they do
# not stop spending.
TTS_MONTHLY_CHAR_LIMIT=200000
# CLOUD_VOICE_VI=vi-VN-Wavenet-A
# CLOUD_VOICE_EN=en-US-Wavenet-F
# CLOUD_VOICE_JA=ja-JP-Wavenet-B
