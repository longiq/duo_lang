GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
# The app is a public URL with no login: this is what actually stands between
# it and someone else spending the whole day's free Gemini quota before you
# wake up. Check the model's requests-per-day on
# https://ai.google.dev/gemini-api/docs/models before raising it. See "Nếu bị
# lạm dụng" in deploy/README.md if this ever needs to go lower.
TRANSLATE_DAILY_MAX=400
PORT=3000
# Bind address. Defaults to 127.0.0.1 (behind an nginx reverse proxy).
# Set to 0.0.0.0 only if you need to reach the app directly, e.g. in a container.
HOST=127.0.0.1

# Google Cloud Text-to-Speech. Optional: without it the app falls back to
# Gemini TTS, whose free tier is only 10 requests per day per model.
# See deploy/google-cloud-tts.md, including how to cap spending.
GOOGLE_TTS_API_KEY=
# Google's free allowance is per voice tier, so the app works down the tiers as
# each one fills: Chirp3-HD, Neural2 and Wavenet get 1M characters a month each,
# Standard gets 4M. Each is capped at this fraction of its own allowance,
# because Google's budget alerts only notify -- they do not stop spending.
TTS_BUDGET_FRACTION=0.8
# Best quality first. Reorder freely; every tier is free within its cap.
TTS_TIER_ORDER=Chirp3-HD,Neural2,Wavenet,Standard
# Per-tier overrides, if a fraction of the free tier is not what you want:
# TTS_BUDGET_CHIRP3_HD=800000
# TTS_BUDGET_NEURAL2=800000
# TTS_BUDGET_WAVENET=800000
# TTS_BUDGET_STANDARD=3200000
# Optional ceiling across all tiers combined. Off unless set above zero.
# TTS_MONTHLY_CHAR_LIMIT=0

# The following are read by the server but only ever need to change for tests,
# which point them at a local stand-in so the suite spends no real quota. Leave
# unset in a normal deploy.
# GEMINI_ENDPOINT_BASE=https://generativelanguage.googleapis.com/v1beta/models
# CLOUD_TTS_ENDPOINT=https://texttospeech.googleapis.com/v1/text:synthesize
# Each Gemini TTS model carries its own free tier of 10 requests/day, so this is
# a cascade, not a preference -- exhausting the first falls through to the next.
# GEMINI_TTS_MODELS=gemini-2.5-flash-preview-tts,gemini-3.1-flash-tts-preview
# Where the monthly TTS character budget is persisted, so a restart cannot
# silently reset it. Defaults next to the repo as tts-usage.json.
# TTS_USAGE_FILE=./tts-usage.json
